# Names only. Leave the values empty in this example and do not commit a filled .env file.
# TEST_APP_URL is the application UI. TEST_ENV is the target environment name, such as QA.
TEST_APP_URL=
TEST_ENV=
# Required only by tests that use the authenticated page fixture.
TEST_EMAIL=
TEST_PASSWORD=
# Optional API address for a future phase. The current ADLC phase does not run API tests.
TEST_BASE_URL=
TEST_API_BASE_URL=
# Optional execution settings. Chromium is always included.
TEST_BROWSERS=
TEST_HEADLESS=
TEST_WORKERS=
TEST_TIMEOUT=
TEST_RETRIES=
TEST_ACTION_TIMEOUT=
